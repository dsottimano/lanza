{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
