{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Render code loads tenant data via root-relative imports (`/data/*.json`) —
    // Vite resolves `/` to the project root natively; this mapping teaches tsc the
    // same so `astro check` type-resolves them. See docs/lanza-site-extraction-plan.md.
    "paths": {
      "/data/*": ["./data/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  // The CMS and optional Worker integrations are separate packages with their
  // own typecheck commands and runtime types. They are not Astro source.
  "exclude": ["dist", "public/admin", "admin", "integrations"]
}
