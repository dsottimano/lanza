---
// Single page body — the <main> shared by the EN route (/about/) and the
// localized mirror (/es/about/). Pages render a schema-defined preset or the rich body.
import type { CollectionEntry } from "astro:content";
import { splitId } from "../lib/i18n";
import LegacyBlocks from "./LegacyPageBlocks.astro";
import { legacyPageBlocks } from "../lib/legacy-page-blocks";
import HtmlTemplate from "./HtmlTemplate.astro";
import HomepageMotion from "./HomepageMotion.astro";
import LaunchCar from "./LaunchCar.astro";
import { sanitizeBody } from "../lib/sanitize";
// Build-time check on the sanitizer's OUTPUT. A post body is attacker-reachable (the
// Telegram bot commits raw HTML; an MCP agent writes bodies) and DOMPurify being
// correct is its only defence — so verify the result rather than trust the transform.
// See frontend/lib/assert-rendered-safe.ts.
import { assertSanitizedSafe } from "../lib/assert-rendered-safe";
import { resolveTemplate, templateClass, isLanding } from "../lib/templates";

interface Props {
  page: CollectionEntry<"pages">;
  // Resolved template name (from PagePage). Drives the <main> class + landing chrome.
  template?: string;
}

const { page } = Astro.props;
const body = assertSanitizedSafe(sanitizeBody(page.body ?? ""), "page body");
const template = Astro.props.template ?? resolveTemplate(page.data);
const landing = isLanding(template);
const legacyBlocks = legacyPageBlocks(page.data);
---

<main class={templateClass(template)}>
  {
    page.data.preset ? (
      // A chosen template owns the whole page — skip the default title/body chrome.
      // The sanitized body is exposed as a reserved `body` slot so a template that
      // opts in (fields.json `"body": true`) can place it with {{{ body }}}.
      <HtmlTemplate
        name={page.data.preset}
        locale={splitId(page.id).locale}
        data={{ ...(page.data.slots ?? {}), body }}
      />
    ) : (
      <>
        {!landing && <h1>{page.data.title}</h1>}
        {page.data.featuredImage && (
          <img src={page.data.featuredImage} alt={page.data.title} />
        )}
        {legacyBlocks.length > 0 && <LegacyBlocks blocks={legacyBlocks} />}
        <article class="post-body" set:html={body} />
      </>
    )
  }
</main>

{page.data.preset === "editorial" && <HomepageMotion />}
{page.data.preset === "editorial" && <LaunchCar />}
