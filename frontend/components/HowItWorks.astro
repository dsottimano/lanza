---
// /how-it-works — the dev/agent deep dive: the life of an edit, scroll-scrubbed.
// A sticky trajectory diagram on the left; scrolling stage panels on the right.
// A tiny IntersectionObserver lights the active node + fills the trajectory line
// as you scroll; with JS off or reduced-motion it degrades to a fully-readable
// stacked list (every node lit, every panel shown). Honest architecture — the
// real stack, named: your words → agent → git → GitHub → Cloudflare Pages
// (Astro) → global edge → Google + agents. Static + cacheable (inline is:inline
// script only). Bilingual. Rendered by pages/how-it-works.astro + en mirror.
import { DEFAULT_LOCALE, localeUrl, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const isEn = locale === "en";
// Internal links go through localeUrl, which applies the ONE prefix rule (default
// locale at the root, others prefixed). This used to be `isEn ? "/en" : ""`, from
// when the default locale was Spanish — after the switch to en-default it was
// exactly backwards: the English page linked to /en/start (404) and the Spanish
// page linked to /start (the English one). Deriving it removes the magic string,
// so flipping data/site.json can never strand these links again.
const href = (path: string) => localeUrl(locale, path);

const es = {
  tag: "CÓMO FUNCIONA · SIN MAGIA",
  headline: "La vida de un cambio, de principio a fin.",
  sub: "Sin base de datos. Sin servidor. Sin ataduras. Su sitio es una carpeta de archivos en un repositorio suyo; un agente la edita y dos plataformas la sirven. Esto es todo lo que pasa.",
  stages: [
    { t: "Usted describe el cambio", code: "en lenguaje natural", b: "Le dice a un agente de IA qué quiere, en cualquier idioma. Sin sintaxis, sin panel de administración que aprender." },
    { t: "El agente edita el repositorio", code: "read schema.ts · write .md/.html", b: "El agente lee su modelo de contenido, edita los archivos correctos y guarda el cambio como un commit, igual que lo haría un programador." },
    { t: "GitHub guarda la versión", code: "git push origin main", b: "Su repositorio es la fuente de la verdad. Cada versión queda registrada y es reversible. El repositorio le pertenece: lléveselo cuando quiera." },
    { t: "Cloudflare Pages construye", code: "astro build", b: "Un build estático compila los archivos a HTML puro. Nada que ejecutar en producción, nada que hackear, nada que parchar." },
    { t: "El borde global lo sirve", code: "300+ ciudades · en caché", b: "Su sitio sale desde la red de Cloudflare, cerca de cada visitante. Las vistas de página no se miden, así que es rápido en todas partes y gratis." },
    { t: "Google y los agentes lo encuentran", code: "sitemap.xml · llms.txt", b: "Es un sitio real en la web abierta, con URLs reales, datos estructurados y un contrato para agentes. Se puede descubrir por diseño." },
  ],
  stackEyebrow: "La pila, con sus nombres",
  stackHead: "Cuatro herramientas corrientes, cada una en lo suyo.",
  stackIntro: "Aquí no se inventó nada. Astro renderiza, Git recuerda, Cloudflare sirve y un pequeño intermediario guarda los secretos para que su sitio no tenga que guardarlos. Lo que hace Lanza es conectarlas y luego apartarse.",
  stack: [
    {
      k: "astro build",
      t: "Astro lo renderiza",
      b: "Astro compila los componentes a HTML por adelantado y no envía ningún framework al navegador. El código de render no está en su repositorio: vive en el paquete npm lanza-site, y el srcDir de Astro apunta ahí dentro. Su repositorio guarda palabras, datos y plantillas. Las plantillas son HTML corriente con {{marcadores}}, y por eso un agente puede escribir una y una persona todavía puede leerla.",
    },
    {
      k: "git push origin main",
      t: "Git lo recuerda",
      b: "Cada página es un archivo. Cada guardado es un commit en la rama de preparación, y publicar es una fusión hacia main. Ese es todo el modelo de publicación. No hay base de datos, así que no hay nada que migrar, nada que respaldar y ninguna función de exportación que construir: git clone es la exportación y git revert es el deshacer.",
    },
    {
      k: "push → build → borde",
      t: "Cloudflare Pages lo sirve",
      b: "Pages observa el repositorio, ejecuta el build en cada push y sirve el resultado desde unas 300 ciudades. Las vistas de página no se miden, así que el tráfico nunca mueve la factura. Las vistas previas por rama son lo que hace real la preparación: su borrador tiene su propia URL, construida por la misma tubería que producción. Un puñado de Pages Functions cubre lo que no puede ser estático: la puerta de /admin, el proxy de GitHub y /api/mcp. Toda ruta pública sigue siendo estática y cacheada.",
    },
    {
      k: "connect.lanzacms.com",
      t: "El intermediario guarda los secretos",
      b: "Su sitio es un inquilino, y un inquilino no guarda ninguna clave privada: lleva una clave pública y solo puede verificar. El intermediario es la otra mitad. Gestiona el alta, firma una sesión RS256 de vida corta que nombra su usuario de GitHub y el origen de su sitio, y emite un token de GitHub por guardado, limitado a un repositorio y válido cerca de una hora. Su sitio comprueba la firma y luego comprueba, por separado, que esa persona es propietaria: una firma válida demuestra que alguien inició sesión, no que el sitio sea suyo.",
    },
  ],

  repoEyebrow: "Lo que posee de verdad",
  repoHead: "Un repositorio delgado y una versión que usted fija.",
  repoBody: "Esto es un sitio Lanza entero. El código llega como dependencia en la versión que usted elija, así que nada de lo que publiquemos toca su sitio hasta que usted lo tome.",
  repoTree: [
    ["su-sitio/", ""],
    ["  package.json", "lanza-site, fijado a una versión exacta"],
    ["  astro.config.mjs", "export default lanzaConfig()"],
    ["  lanza.config.json", "{ owner, name }"],
    ["  content/", "sus palabras: entradas, páginas, autores, etiquetas"],
    ["  data/", "site.json, schema.json, appearance.json"],
    ["  templates/", "plantillas de página: HTML con {{marcadores}}"],
    ["  public/images/", "lo que usted suba"],
  ],
  repoNote: "npm install && lanza build produce el mismo sitio estático que construye Cloudflare. Clónelo, ejecútelo, lléveselo a otra parte: nada de ese árbol nos necesita.",

  devEyebrow: "Para desarrolladores",
  devHead: "Es suyo hasta el último archivo.",
  devBody: "Astro + Git + Cloudflare Pages, todo en el plan gratuito. Sin base de datos que administrar, sin runtime que mantener. Sáltese el asistente de connect.lanzacms.com por completo: bifúrquelo, alójelo usted mismo, conecte su propio agente al mismo modelo de contenido. Nada aquí le retiene.",
  devLink: "Leer el contrato para agentes",
  devLinkArch: "Ver la arquitectura completa",
  colEyebrow: "Colofón",
  colHead: "Construido con orgullo con Claude Code.",
  colBody: "Lanza se hizo así a propósito. El CMS, el motor de render, esta página y el sitio que la rodea se construyeron con Claude Code: un agente trabajando en el mismo repositorio, con los mismos commits y las mismas revisiones que usaría un programador. Una herramienta para editar un sitio hablando con un agente debería estar construida hablando con un agente. Y la prueba es pública: el historial entero está en el repositorio, con los errores incluidos.",
  colLink: "Ver el repositorio",
  ctaHead: "¿Listo para lanzar?",
  ctaSub: "Vea lo que cuesta y empiece en unos 30 minutos.",
  cta: "Empezar",
};

const en = {
  tag: "HOW IT WORKS · NO MAGIC",
  headline: "The life of an edit, end to end.",
  sub: "No database. No server. No lock-in. Your site is a folder of files in a repository you own; an agent edits it and two platforms serve it. This is everything that happens.",
  stages: [
    { t: "You describe the change", code: "in plain language", b: "Tell an AI agent what you want, in any language. No syntax, no admin panel to learn." },
    { t: "The agent edits the repo", code: "read schema.ts · write .md/.html", b: "The agent reads your content model, edits the right files, and saves the change as a commit, exactly like a developer would." },
    { t: "GitHub stores the version", code: "git push origin main", b: "Your repository is the source of truth. Every version is recorded and reversible. The repo belongs to you: take it anywhere, any time." },
    { t: "Cloudflare Pages builds", code: "astro build", b: "A static build compiles the files to plain HTML. Nothing to run in production, nothing to hack, nothing to patch." },
    { t: "The global edge serves it", code: "300+ cities · cached", b: "Your site goes out from Cloudflare's network, close to every visitor. Page views are unmetered, so it is fast everywhere, and free." },
    { t: "Google and agents find it", code: "sitemap.xml · llms.txt", b: "It's a real site on the open web, with real URLs, structured data, and a contract for agents. Discoverable by design." },
  ],
  stackEyebrow: "The stack, named",
  stackHead: "Four ordinary tools, each doing its own job.",
  stackIntro: "Nothing here was invented. Astro renders, Git remembers, Cloudflare serves, and one small broker holds the secrets so your site never has to. What Lanza does is wire them together and then get out of the way.",
  stack: [
    {
      k: "astro build",
      t: "Astro renders it",
      b: "Astro compiles components to HTML ahead of time and ships no framework to the browser. The rendering code is not in your repository: it lives in the lanza-site npm package, and Astro's srcDir points into it. Your repo holds words, data and templates. The templates are ordinary HTML with {{placeholders}}, which is what lets an agent write one and a person still read it.",
    },
    {
      k: "git push origin main",
      t: "Git remembers it",
      b: "Every page is a file. Every save is a commit on the staging branch, and publishing is a merge into main. That is the entire publishing model. There is no database, so there is nothing to migrate, nothing to back up and no export feature to build: git clone is the export, and git revert is the undo.",
    },
    {
      k: "push → build → edge",
      t: "Cloudflare Pages serves it",
      b: "Pages watches the repository, runs the build on every push, and serves the result from around 300 cities. Page views are unmetered, so traffic never moves the bill. Branch previews are what make staging real: your draft gets its own URL, built by the same pipeline as production. A handful of Pages Functions cover what cannot be static: the /admin gate, the GitHub proxy and /api/mcp. Every public route stays static and cached.",
    },
    {
      k: "connect.lanzacms.com",
      t: "The broker holds the secrets",
      b: "Your site is a tenant, and a tenant holds no private key: it ships with a public one and can only verify. The broker is the other half. It runs onboarding, signs a short-lived RS256 session naming your GitHub login and your site's origin, and mints a GitHub token per save, scoped to one repository and good for about an hour. Your site checks the signature, then checks separately that the person is an owner: a valid signature proves someone signed in, not that the site is theirs.",
    },
  ],

  repoEyebrow: "What you actually own",
  repoHead: "A thin repository, and a version you pin.",
  repoBody: "This is a whole Lanza site. The code arrives as a dependency at a version you choose, so nothing we publish reaches your site until you take it.",
  repoTree: [
    ["your-site/", ""],
    ["  package.json", "lanza-site, pinned to an exact version"],
    ["  astro.config.mjs", "export default lanzaConfig()"],
    ["  lanza.config.json", "{ owner, name }"],
    ["  content/", "your words: posts, pages, authors, tags"],
    ["  data/", "site.json, schema.json, appearance.json"],
    ["  templates/", "page templates: HTML with {{placeholders}}"],
    ["  public/images/", "anything you upload"],
  ],
  repoNote: "npm install && lanza build produces the same static site Cloudflare builds. Clone it, run it, take it somewhere else; nothing in that tree needs us.",

  devEyebrow: "For developers",
  devHead: "Yours down to the last file.",
  devBody: "Astro + Git + Cloudflare Pages, all on the free tier. No database to run, no runtime to keep alive. Skip the connect.lanzacms.com wizard entirely: fork it, self-host it, point your own agent at the same content model. Nothing here holds you in.",
  devLink: "Read the agent contract",
  devLinkArch: "See the full architecture",
  colEyebrow: "Colophon",
  colHead: "Proudly built with Claude Code.",
  colBody: "Lanza was made this way on purpose. The CMS, the render engine, this page and the site around it were built with Claude Code: an agent working in the same repository, through the same commits and the same reviews a developer would use. A tool for editing a site by talking to an agent ought to be built by talking to an agent. And the proof is public: the whole history is in the repository, mistakes included.",
  colLink: "Browse the repository",
  ctaHead: "Ready to launch?",
  ctaSub: "See what it costs and start in about 30 minutes.",
  cta: "Start your site",
};

const t = isEn ? en : es;
---

<div class="hiw">
  <header class="hiw-head">
    <span class="hiw-tag">{t.tag}</span>
    <h1 class="hiw-headline">{t.headline}</h1>
    <p class="hiw-sub">{t.sub}</p>
  </header>

  <div class="hiw-scrolly">
    <!-- sticky trajectory diagram -->
    <aside class="hiw-stage" aria-hidden="true">
      <div class="hiw-diagram">
        <span class="hiw-diagram__track"></span>
        <span class="hiw-diagram__fill" data-hiw-fill></span>
        {t.stages.map((s, i) => (
          <span class="hiw-node is-lit" data-hiw-node style={`--i:${i}`}>
            <span class="hiw-node__dot"></span>
            <span class="hiw-node__t">{s.t}</span>
          </span>
        ))}
        <span class="hiw-diagram__arrow">↗</span>
      </div>
    </aside>

    <!-- scrolling stage panels -->
    <ol class="hiw-panels">
      {t.stages.map((s, i) => (
        <li class="hiw-panel" data-hiw-panel={i}>
          <div class="hiw-panel__inner">
            <span class="hiw-panel__num">{String(i + 1).padStart(2, "0")} / {String(t.stages.length).padStart(2, "0")}</span>
            <h2 class="hiw-panel__t">{s.t}</h2>
            <code class="hiw-panel__code">{s.code}</code>
            <p class="hiw-panel__b">{s.b}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <!-- the stack, named: what each ordinary tool is doing here -->
  <section class="hiw-sec">
    <div class="hiw-wrap">
      <span class="hiw-sec__eyebrow">{t.stackEyebrow}</span>
      <h2 class="hiw-sec__h2">{t.stackHead}</h2>
      <p class="hiw-sec__lede">{t.stackIntro}</p>
      <div class="hiw-cards">
        {t.stack.map((s) => (
          <article class="hiw-card">
            <code class="hiw-card__k">{s.k}</code>
            <h3 class="hiw-card__t">{s.t}</h3>
            <p class="hiw-card__b">{s.b}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- the tenant repo, as a tree -->
  <section class="hiw-sec hiw-sec--alt">
    <div class="hiw-wrap">
      <span class="hiw-sec__eyebrow">{t.repoEyebrow}</span>
      <h2 class="hiw-sec__h2">{t.repoHead}</h2>
      <p class="hiw-sec__lede">{t.repoBody}</p>
      <div class="hiw-tree">
        {t.repoTree.map(([p, c]) => (
          <div class="hiw-tree__row">
            <span class="hiw-tree__p">{p}</span>
            <span class="hiw-tree__c">{c}</span>
          </div>
        ))}
      </div>
      <p class="hiw-tree__note">{t.repoNote}</p>
    </div>
  </section>

  <!-- developer / agent callout -->
  <section class="hiw-band">
    <div class="hiw-wrap">
      <span class="hiw-eyebrow">{t.devEyebrow}</span>
      <h2 class="hiw-h2">{t.devHead}</h2>
      <p class="hiw-lede">{t.devBody}</p>
      <p class="hiw-links">
        <a class="hiw-link" href={href("architecture/")}>{t.devLinkArch}<span class="hiw-arrow" aria-hidden="true">↗</span></a>
        <a class="hiw-link" href={href("agents/")}>{t.devLink}<span class="hiw-arrow" aria-hidden="true">↗</span></a>
      </p>
    </div>
  </section>

  <!-- colophon: who built this, and with what -->
  <section class="hiw-sec hiw-colophon">
    <div class="hiw-wrap hiw-wrap--narrow">
      <span class="hiw-sec__eyebrow">{t.colEyebrow}</span>
      <h2 class="hiw-sec__h2">{t.colHead}</h2>
      <p class="hiw-sec__lede hiw-sec__lede--last">{t.colBody}</p>
      <p class="hiw-links">
        <a class="hiw-link hiw-link--ink" href="https://github.com/dsottimano/lanza" rel="noopener">{t.colLink}<span class="hiw-arrow" aria-hidden="true">↗</span></a>
      </p>
    </div>
  </section>

  <section class="hiw-cta">
    <div class="hiw-wrap hiw-wrap--narrow">
      <h2 class="hiw-cta__head">{t.ctaHead}</h2>
      <p class="hiw-cta__sub">{t.ctaSub}</p>
      <a class="hiw-btn" href={href("start/")}>{t.cta}<span class="hiw-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var panels = document.querySelectorAll("[data-hiw-panel]");
    var nodes = document.querySelectorAll("[data-hiw-node]");
    var fill = document.querySelector("[data-hiw-fill]");
    if (!panels.length || !("IntersectionObserver" in window)) return;
    var last = nodes.length - 1;
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var i = Number(e.target.getAttribute("data-hiw-panel"));
          nodes.forEach(function (n, j) {
            n.classList.toggle("is-lit", j <= i);
            n.classList.toggle("is-active", j === i);
          });
          if (fill) fill.style.setProperty("--fill", last ? i / last : 0);
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    panels.forEach(function (p) {
      io.observe(p);
    });
  })();
</script>

<style>
  .hiw { color: var(--ink); font-family: var(--font-ui); }
  .hiw-wrap { max-width: var(--wide); margin: 0 auto; padding: 0 1.5rem; }
  .hiw-wrap--narrow { max-width: 60rem; }

  /* header */
  .hiw-head { max-width: var(--wide); margin: 0 auto; padding: clamp(3rem, 7vw, 5.5rem) 1.5rem clamp(1.5rem, 4vw, 3rem); }
  .hiw-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: var(--accent);
    padding-bottom: 0.9rem;
    margin-bottom: 1.4rem;
    border-bottom: 1px solid var(--rule);
  }
  .hiw-headline {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(2.4rem, 5.4vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 1.2rem;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hiw-sub { font-size: 1.16rem; line-height: 1.65; color: var(--text-secondary); max-width: 56ch; margin: 0; }

  /* scrolly layout */
  .hiw-scrolly {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  /* sticky diagram */
  .hiw-stage { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; }
  .hiw-diagram { position: relative; width: 100%; padding-left: 1.5rem; }
  .hiw-diagram__track,
  .hiw-diagram__fill {
    position: absolute;
    left: 5px;
    top: 0.4rem;
    bottom: 2.2rem;
    width: 2px;
  }
  .hiw-diagram__track { background: var(--rule); }
  .hiw-diagram__fill {
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(var(--fill, 0));
    transition: transform 420ms cubic-bezier(0.3, 0.7, 0.2, 1);
    bottom: auto;
    height: calc(100% - 2.6rem);
  }
  .hiw-node {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 0;
    margin-left: -1.5rem;
    padding-left: 1.5rem;
  }
  .hiw-node__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--muted);
    transition: background 260ms ease, border-color 260ms ease, transform 260ms ease;
  }
  .hiw-node__t {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    transition: color 260ms ease;
  }
  .hiw-node.is-lit .hiw-node__dot { border-color: var(--accent); }
  .hiw-node.is-lit .hiw-node__t { color: var(--text-secondary); }
  .hiw-node.is-active .hiw-node__dot { background: var(--accent); border-color: var(--accent); transform: scale(1.25); }
  .hiw-node.is-active .hiw-node__t { color: var(--ink); font-weight: 500; }
  .hiw-diagram__arrow {
    position: absolute;
    left: -1px;
    bottom: 0;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--accent);
    font-weight: 600;
  }

  /* scrolling panels */
  .hiw-panels { list-style: none; margin: 0; padding: 0; }
  .hiw-panel { min-height: 82vh; display: flex; align-items: center; }
  .hiw-panel:last-child { min-height: 60vh; }
  .hiw-panel__inner {
    border-left: 3px solid var(--accent);
    padding: 0.4rem 0 0.4rem 1.6rem;
  }
  .hiw-panel__num { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--accent); }
  .hiw-panel__t {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0.6rem 0 0.9rem;
    max-width: 16ch;
  }
  .hiw-panel__code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.3rem 0.6rem;
    margin-bottom: 1.1rem;
  }
  .hiw-panel__b { font-size: 1.08rem; line-height: 1.65; color: var(--text-secondary); max-width: 44ch; margin: 0; }

  /* light sections (the stack, the repo tree, the colophon) — the dark band below
     owns .hiw-eyebrow/.hiw-h2/.hiw-lede, so these carry their own light-ground set
     rather than fighting it with modifiers. */
  .hiw-sec { padding: clamp(3.5rem, 8vw, 5.5rem) 0; }
  .hiw-sec--alt { background: var(--surface); }
  .hiw-sec__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.1rem;
  }
  .hiw-sec__h2 {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0 0 1.1rem;
    max-width: 22ch;
  }
