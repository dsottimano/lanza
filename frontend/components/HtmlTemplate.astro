---
// Renders an author-written HTML template with a page's data via the minimal engine
// in frontend/lib/template-render.ts. Templates live in the TENANT repo root
// (templates/<name>/template.html) — agent-authored, hand-editable HTML/CSS with
// {{placeholders}}, so they survive lanza-site package updates. The leading-slash
// glob resolves against the Vite/Astro project ROOT (cwd), which is the tenant repo
// in both the monorepo dogfood and an installed tenant — NOT srcDir (the package).
//
// The template owns the whole page; its {{placeholders}} are filled from the entry's
// freeform `slots`. The template markup is author-trusted (emitted verbatim); the
// engine HTML-escapes only the interpolated values, so no sanitize pass here.
// renderChecked is render() plus a build-time parse5 check on the OUTPUT: it fails
// the build if a VALUE produced markup a browser would act on. See
// frontend/lib/assert-rendered-safe.ts.
import { pageListingScope } from "../lib/page-listing";
import { renderChecked, assertSanitizedSafe } from "../lib/assert-rendered-safe";
import { sanitizeRichFields } from "../lib/sanitize";
import { RICH_TEXT_CSS, richTextFields } from "../../functions/_lib/rich-text.mjs";

interface Props {
  name: string;
  data?: Record<string, unknown>;
  locale?: import("../lib/i18n").Locale;
}

const { name, data = {} } = Astro.props;

// Eager, raw glob so the template map resolves at build time (static site).
const templates = import.meta.glob<string>("/templates/*/template.html", {
  query: "?raw",
  import: "default",
  eager: true,
});
const source = templates[`/templates/${name}/template.html`];
// Richtext fields are the one slot value rendered raw ({{{ name }}}), so they are
// sanitized here, at the single public render sink, and the result is verified.
const declarations = import.meta.glob<unknown>("/templates/*/fields.json", { import: "default", eager: true });
const fieldsJson = declarations[`/templates/${name}/fields.json`] ?? null;
const richNames = richTextFields((fieldsJson as { fields?: unknown } | null)?.fields);
const listed = Astro.props.locale ? await pageListingScope(name, Astro.props.locale, data) : data;
const scope = sanitizeRichFields(listed, fieldsJson);
for (const field of richNames) assertSanitizedSafe(String(scope[field]), `templates/${name} field "${field}"`);
const html = source ? renderChecked(source, scope, `templates/${name}/template.html`) : null;
---

{
  html !== null ? (
    <>
      {richNames.length > 0 && <style is:inline set:html={RICH_TEXT_CSS} />}
      <Fragment set:html={html} />
    </>
  ) : (
    // Unknown/removed template — never break the render; surface it plainly instead.
    <p class="preset-missing">Unknown template “{name}”.</p>
  )
}
