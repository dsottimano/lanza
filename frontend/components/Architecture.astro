---
// /architecture — the deep layer. /how-it-works tells the story of an edit in
// plain language; this page is the wiring diagram behind it, in the dev/agent
// register: every component named, who runs it, who holds which secret, and how
// long each credential lives.
//
// Everything here is checked against the code and docs/ rather than written from
// memory — the sign-in sequence mirrors functions/_lib/device-flow.ts and
// gh-identity.ts, the credential lifetimes mirror docs/keys-and-secrets.md, the
// sovereignty section mirrors docs/security-model.md I3, and the agent section
// mirrors functions/api/mcp.ts. If one of those changes, this page is wrong and
// must change with it.
//
// It was wrong once, for exactly that reason: it described a broker that signed
// sessions and minted repository tokens for months after that stopped being a
// design anyone wanted. The 2026-08-29 release deleted it, and this page is the
// public statement of what replaced it.
//
// Static + cacheable: no client JS at all. Bilingual, driven by the same fixed-page
// registry as its siblings (lib/fixed-pages.ts).
import { DEFAULT_LOCALE, localeUrl, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const isEn = locale === "en";
const href = (path: string) => localeUrl(locale, path);

