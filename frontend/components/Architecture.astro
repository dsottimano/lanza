const t = isEn ? en : es;
---

<div class="arc">
  <header class="arc-head">
    <span class="arc-tag">{t.tag}</span>
    <h1 class="arc-headline">{t.headline}</h1>
    <p class="arc-sub">{t.sub}</p>
  </header>

  <!-- the parts -->
  <section class="arc-sec">
    <div class="arc-wrap">
      <span class="arc-eyebrow">{t.partsEyebrow}</span>
      <h2 class="arc-h2">{t.partsHead}</h2>
      <p class="arc-lede">{t.partsIntro}</p>
      <div class="arc-scroll">
        <table class="arc-table">
          <thead>
            <tr>{t.partsCols.map((c) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {t.parts.map(([name, what, who, secrets]) => (
              <tr>
                <th scope="row">{name}</th>
                <td>{what}</td>
                <td class="arc-td--tight">{who}</td>
                <td class="arc-td--tight">
                  <span class={secrets === "No" ? "arc-flag arc-flag--no" : "arc-flag arc-flag--yes"}>{secrets}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- life of an edit -->
  <section class="arc-sec arc-sec--tint">
    <div class="arc-wrap">
      <span class="arc-eyebrow">{t.editEyebrow}</span>
      <h2 class="arc-h2">{t.editHead}</h2>
      <p class="arc-lede">{t.editIntro}</p>
      <ol class="arc-steps">
        {t.editSteps.map((s, i) => (
          <li class="arc-step">
            <span class="arc-step__num">{String(i + 1).padStart(2, "0")}</span>
            <div class="arc-step__body">
              <h3 class="arc-step__t">{s.t}</h3>
              <code class="arc-code">{s.c}</code>
              <p class="arc-step__b">{s.b}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- signing in -->
  <section class="arc-sec">
    <div class="arc-wrap">
      <span class="arc-eyebrow">{t.authEyebrow}</span>
      <h2 class="arc-h2">{t.authHead}</h2>
      <p class="arc-lede">{t.authIntro}</p>
      <ol class="arc-seq">
        {t.authSteps.map((s) => <li>{s}</li>)}
      </ol>
      <aside class="arc-callout">
        <h3 class="arc-callout__t">{t.authCalloutHead}</h3>
        <p class="arc-callout__b">{t.authCalloutBody}</p>
      </aside>
    </div>
  </section>

  <!-- blast radius -->
  <section class="arc-sec arc-sec--tint">
    <div class="arc-wrap">
      <span class="arc-eyebrow">{t.keysEyebrow}</span>
      <h2 class="arc-h2">{t.keysHead}</h2>
      <p class="arc-lede">{t.keysIntro}</p>
      <div class="arc-scroll">
        <table class="arc-table">
          <thead>
            <tr>{t.keysCols.map((c) => <th scope="col">{c}</th>)}</tr>
          </thead>
          <tbody>
            {t.keys.map(([cred, reaches, life]) => (
              <tr>
                <th scope="row">{cred}</th>
                <td>{reaches}</td>
                <td class="arc-td--tight"><code class="arc-code arc-code--bare">{life}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- agents -->
  <section class="arc-band">
    <div class="arc-wrap">
      <span class="arc-eyebrow arc-eyebrow--bright">{t.agentEyebrow}</span>
      <h2 class="arc-h2 arc-h2--invert">{t.agentHead}</h2>
      <p class="arc-lede arc-lede--invert">{t.agentBody}</p>
      <a class="arc-link" href={href("agents/")}>{t.agentLink}<span class="arc-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- cost -->
  <section class="arc-sec">
    <div class="arc-wrap">
      <span class="arc-eyebrow">{t.costEyebrow}</span>
      <h2 class="arc-h2">{t.costHead}</h2>
      <p class="arc-lede">{t.costBody}</p>
      <div class="arc-tiles">
        {t.costTiles.map(([value, label]) => (
          <div class="arc-tile">
            <span class="arc-tile__v">{value}</span>
            <span class="arc-tile__l">{label}</span>
