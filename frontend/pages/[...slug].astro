---
import type { CollectionEntry } from "astro:content";
import PagePage from "../components/PagePage.astro";
import FixedPage from "../components/FixedPage.astro";
import { DEFAULT_LOCALE } from "../lib/i18n";
import { getCollection } from "astro:content";
import { publishedPages } from "../lib/routing";
import { splitEntries } from "../lib/paths";
import { FIXED_PAGES } from "../lib/fixed-pages";

// CMS entries own their URLs, including drafts (no fallback may resurrect them).
export async function getStaticPaths() {
  const { root } = splitEntries(await publishedPages());
  const cms = root
    .filter(({ slug }) => slug !== "")
    .map(({ entry, slug }) => ({ params: { slug }, props: { page: entry } }));
  const allPages = await getCollection("pages");
  const owned = splitEntries(allPages);
  const fixed = FIXED_PAGES.filter((p) => !owned.root.some((entry) => entry.slug === p.slug || entry.entry.id.endsWith(`/${p.slug}`))).map((p) => ({
    params: { slug: p.slug },
    props: { fixed: p.slug },
  }));
  return [...cms, ...fixed];
}

const { page, fixed } = Astro.props;
---

{
  fixed ? (
    <FixedPage slug={fixed} locale={DEFAULT_LOCALE} />
  ) : (
    <PagePage page={page as CollectionEntry<"pages">} locale={DEFAULT_LOCALE} />
  )
}
