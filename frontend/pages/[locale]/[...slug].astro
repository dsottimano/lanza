---
import type { CollectionEntry } from "astro:content";
import PagePage from "../../components/PagePage.astro";
import PostPage from "../../components/PostPage.astro";
import FixedPage from "../../components/FixedPage.astro";
import { getCollection } from "astro:content";
import { publishedPages } from "../../lib/routing";
import { splitEntries, otherLocales } from "../../lib/paths";
import { FIXED_PAGES } from "../../lib/fixed-pages";
import { rootPosts } from "../../lib/root-posts";

// CMS entries own their URLs in every enabled locale. Posts join this URL space only
// when the posts route serves them at the site root (/<locale>/<slug>/).
export async function getStaticPaths() {
  const { localized } = splitEntries(await publishedPages());
  const cms = localized
    .filter(({ slug }) => slug !== "")
    .map(({ entry, locale, slug }) => ({
      params: { locale, slug },
      props: { page: entry, locale },
    }));
  const allPages = await getCollection("pages");
  const owned = splitEntries(allPages);
  const fixed = otherLocales().flatMap((locale) =>
    FIXED_PAGES.filter((p) => !owned.localized.some((entry) => entry.locale === locale && (entry.slug === p.slug || entry.entry.id === `${locale}/${p.slug}`))).map((p) => ({
      params: { locale, slug: p.slug },
      props: { fixed: p.slug, locale },
    })),
  );
  const posts = [];
  for (const locale of otherLocales()) {
    const pages = owned.localized.filter((entry) => entry.locale === locale);
    const fixedHere = fixed.filter((f) => f.params.locale === locale).map((f) => f.params.slug);
    for (const { entry, slug } of await rootPosts(locale, pages, fixedHere)) {
      posts.push({ params: { locale, slug }, props: { post: entry, locale } });
    }
  }
  return [...cms, ...fixed, ...posts];
}

const { page, fixed, post, locale } = Astro.props;
---

{
  post ? (
    <PostPage post={post as CollectionEntry<"posts">} locale={locale} />
  ) : fixed ? (
    <FixedPage slug={fixed} locale={locale} />
  ) : (
    <PagePage page={page as CollectionEntry<"pages">} locale={locale} />
  )
}
