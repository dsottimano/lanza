{
  "name": "lanza-site",
  "version": "0.1.11",
  "private": false,
  "type": "module",
  "bin": {
    "lanza": "bin/lanza.mjs"
  },
  "exports": {
    "./astro": "./astro-config.mjs"
  },
  "files": [
    "astro-config.mjs",
    "bin",
    "frontend",
    "functions",
    "public/_headers",
    "public/admin",
    "public/brand",
    "public/favicon",
    "public/social",
    "public/lanza.js",
    "scripts",
    "!**/*.test.mjs",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:admin": "npm --prefix admin ci && npm --prefix admin run build",
    "build": "npm run build:admin && node bin/lanza.mjs build",
    "prepack": "npm run build:admin",
    "preview": "astro preview",
    "check": "astro check",
    "test:functions": "node --experimental-strip-types --loader ./functions/_lib/ts-resolve.mjs --test functions/_lib/*.test.mjs scripts/*.test.mjs",
    "test": "npm run test:functions && npm --prefix admin test"
  },
  "dependencies": {
    "astro": "7.1.3",
    "isomorphic-dompurify": "3.19.0",
    "js-yaml": "4.3.0",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/js-yaml": "4.0.9",
    "typescript": "6.0.3"
  }
}
